{
  "manifest_version": 3,
  "name": "Now Bar",
  "version": "0.2.0",
  "description": "Always-on-top now-playing floater for YouTube Music and Spotify Web, with a dotted ASCII axolotl scene. Nothing leaves your machine.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://music.youtube.com/*",
    "https://open.spotify.com/*"
  ],
  "background": {
    "service_worker": "mailbox/service-worker.js"
  },
  "action": {
    "default_title": "Now Bar",
    "default_popup": "panel/panel.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "adapter/youtube-music.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://open.spotify.com/*"
      ],
      "js": [
        "adapter/spotify-web.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon-48.png"
      ],
      "matches": [
        "https://music.youtube.com/*",
        "https://open.spotify.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; img-src 'self' https://i.scdn.co https://mosaic.scdn.co https://*.spotifycdn.com https://i.ytimg.com https://*.ytimg.com https://lh3.googleusercontent.com https://*.googleusercontent.com https://*.ggpht.com; style-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; frame-src 'none'"
  }
}
